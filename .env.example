# App Environment Variables Example
# Copy this file to .env or .env.local for local development settings.

# --- Client (build-time, Vite) ---
# Socket.io 서버 URL. 비워두면 window.location.origin을 사용한다.
VITE_SERVER_URL=http://localhost:8080

# --- Server (runtime) ---
# Redis 연결 URL. 없으면 방 상태/리더보드가 인메모리로 동작하며
# 멀티 인스턴스 매치메이킹이 불가능하다.
REDIS_URL=redis://localhost:6379

# REDIS_URL 대신 호스트/포트로 지정할 수도 있다 (Cloud Run + Memorystore).
# REDIS_HOST=10.0.0.3
# REDIS_PORT=6379
